<?xml version="1.0" encoding="utf-8"?>
<!-- A new screen fades in over the one it came from, which holds still underneath: no slide, no zoom. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="0" android:toAlpha="1" android:duration="200"
    android:interpolator="@android:interpolator/decelerate_cubic" />
