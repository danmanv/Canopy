<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates itself from the GitHub releases (Updates.kt) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Continue Watching on the Google TV home (WatchNext.kt) -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@drawable/logo"
        android:theme="@style/Canopy"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="true">
        <!-- Back stays a key (KEYCODE_BACK): every screen's own Back handling works the same from a remote and from a
             phone's back gesture. -->
        <!-- Plain http:// as Stremio allows it: self-hosted add-ons (http://192.168.…:7000), debrid proxies and IPTV
             links. Android 9+ blocks it otherwise, and every such add-on and stream failed. -->

        <activity
            android:name=".ProfilesActivity"
            android:exported="true">
            <!-- Sideways on a TV, upright on a phone: set on start (ProfilesActivity.onCreate). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:screenOrientation="sensorLandscape" />
        <!-- Home on a phone, held upright -->
        <activity android:name=".PhoneActivity" android:screenOrientation="portrait" />
        <activity android:name=".PhoneDetailsActivity" android:screenOrientation="portrait" />
        <activity android:name=".PhoneStreamsActivity" android:screenOrientation="portrait" />
        <activity android:name=".PhoneSearchActivity" android:screenOrientation="portrait" android:launchMode="singleTop" />
        <!-- The TV's own search hands a query here: the Assistant's "search for … on Canopy" and global search. -->
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.searchable" android:resource="@xml/searchable" />
        </activity>
        <activity android:name=".SettingsActivity" />
        <activity android:name=".AddonsActivity" android:screenOrientation="sensorLandscape" />
        <activity android:name=".DetailsActivity" android:screenOrientation="sensorLandscape" />
        <activity android:name=".CatalogActivity" android:screenOrientation="sensorLandscape" />
        <activity android:name=".StreamsActivity" android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".PlayerActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout" />
        <activity
            android:name=".ScreensaverActivity"
            android:screenOrientation="sensorLandscape"
            android:excludeFromRecents="true"
            android:noHistory="true" />
        <!-- The same slideshow as the TV's own screensaver (Settings › Screensaver on the TV) -->
        <service
            android:name=".CanopyDream"
            android:exported="true"
            android:label="Canopy"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <receiver android:name=".Updates$Status" android:exported="false" />
    </application>
</manifest>
